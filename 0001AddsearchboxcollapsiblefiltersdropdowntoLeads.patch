From c6ced7b9917fb8f1a4331800abdf8694701e956b Mon Sep 17 00:00:00 2001
From: Rinaldo J <rinaldo@elmeasure.com>
Date: Thu, 20 Aug 2026 06:02:18 +0000
Subject: [PATCH] Add search box + collapsible filters dropdown to Leads and
 Potentials tabs

Adds a search input and a 'Filters' toggle button above the existing
filter row on both the Leads and Potentials dashboards. The filter
controls (basket/product/owner/region/status/date range) are now
hidden behind the Filters dropdown by default, showing a badge with
the count of active filters. The search box does a live, client-side
text match across owner, account name, region, product, and (for
Leads) status, combined with any other active filters.
---
 index.html | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/index.html b/index.html
index aff7d64..a57f780 100644
--- a/index.html
+++ b/index.html
@@ -95,8 +95,8 @@ function b64ToUtf8(b64) {
 }
 
 const PAYLOADS = {
-  leads: "",
-  potentials: "",
+  leads: "",
+  potentials: "",
   cumulative: "",
   geoleads: "",
   geopotentials: "",
-- 
